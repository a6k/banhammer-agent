[Unit]
Description=BanHammer Agent
After=fail2ban.service

[Service]
User=banhammer
Group=banhammer
ExecStart=/opt/banhammer-agent/.venv/bin/banhammer-agent run
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/banhammer /etc/banhammer
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
